import pandas as pd
import joblib

from scipy.sparse import hstack, csr_matrix

from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    roc_auc_score,
    classification_report,
    confusion_matrix
)

from features.linguistic_features import extract_linguistic_features


# ==================================================
# 1. LOAD DATA
# ==================================================

df = pd.read_csv("data/clean_reviews.csv")

print("Dataset shape:", df.shape)


# ==================================================
# 2. EXTRACT LINGUISTIC FEATURES
# ==================================================

print("\nExtracting linguistic features...")

linguistic_rows = []

for text in df["REVIEW_TEXT"]:
    linguistic_rows.append(
        extract_linguistic_features(text)
    )

linguistic_df = pd.DataFrame(linguistic_rows)

print("Linguistic features:", linguistic_df.shape)


# ==================================================
# 3. PREPARE VERIFIED PURCHASE
# ==================================================

verified = (
    df["VERIFIED_PURCHASE"]
    .fillna("UNKNOWN")
    .astype(str)
    .values
    .reshape(-1, 1)
)

encoder = OneHotEncoder(
    handle_unknown="ignore",
    sparse_output=True
)

verified_encoded = encoder.fit_transform(verified)

print("Verified purchase features:", verified_encoded.shape)


# ==================================================
# 4. TARGET
# ==================================================

texts = df["REVIEW_TEXT"]
y = df["label"]


# ==================================================
# 5. TRAIN-TEST SPLIT
# ==================================================

indices = range(len(df))

train_idx, test_idx = train_test_split(
    indices,
    test_size=0.20,
    random_state=42,
    stratify=y
)

train_idx = list(train_idx)
test_idx = list(test_idx)

print("Training samples:", len(train_idx))
print("Testing samples:", len(test_idx))


# ==================================================
# 6. SPLIT FEATURES
# ==================================================

train_text = texts.iloc[train_idx]
test_text = texts.iloc[test_idx]

train_ling = linguistic_df.iloc[train_idx]
test_ling = linguistic_df.iloc[test_idx]

train_verified = verified_encoded[train_idx]
test_verified = verified_encoded[test_idx]

y_train = y.iloc[train_idx]
y_test = y.iloc[test_idx]


# ==================================================
# 7. TF-IDF
# ==================================================

print("\nCreating TF-IDF features...")

tfidf = TfidfVectorizer(
    lowercase=True,
    stop_words="english",
    ngram_range=(1, 2),
    min_df=2,
    max_df=0.95,
    sublinear_tf=True,
    max_features=100000
)

X_train_text = tfidf.fit_transform(train_text)
X_test_text = tfidf.transform(test_text)

print("TF-IDF training shape:", X_train_text.shape)


# ==================================================
# 8. SCALE LINGUISTIC FEATURES
# ==================================================

scaler = StandardScaler()

X_train_ling = scaler.fit_transform(train_ling)
X_test_ling = scaler.transform(test_ling)

X_train_ling = csr_matrix(X_train_ling)
X_test_ling = csr_matrix(X_test_ling)


# ==================================================
# 9. COMBINE ALL FEATURES
# ==================================================

X_train = hstack([
    X_train_text,
    X_train_ling,
    train_verified
]).tocsr()

X_test = hstack([
    X_test_text,
    X_test_ling,
    test_verified
]).tocsr()

print("Combined training shape:", X_train.shape)
print("Combined testing shape:", X_test.shape)


# ==================================================
# 10. TRAIN MODEL
# ==================================================

print("\nTraining Model F...")
model = LogisticRegression(
    C=1.0,
    class_weight="balanced",
    max_iter=2000,
    solver="liblinear",
    random_state=42
)
model.fit(
    X_train,
    y_train
)


# ==================================================
# 11. PREDICTIONS
# ==================================================

y_pred = model.predict(X_test)

y_score = model.decision_function(X_test)


# ==================================================
# 12. METRICS
# ==================================================

accuracy = accuracy_score(y_test, y_pred)

precision = precision_score(
    y_test,
    y_pred
)

recall = recall_score(
    y_test,
    y_pred
)

f1 = f1_score(
    y_test,
    y_pred
)

roc_auc = roc_auc_score(
    y_test,
    y_score
)


# ==================================================
# 13. RESULTS
# ==================================================

print("\n" + "=" * 60)
print("MODEL F — TEXT + LINGUISTIC + VERIFIED PURCHASE")
print("=" * 60)

print(f"Accuracy : {accuracy:.4f}")
print(f"Precision: {precision:.4f}")
print(f"Recall   : {recall:.4f}")
print(f"F1 Score : {f1:.4f}")
print(f"ROC-AUC  : {roc_auc:.4f}")


# ==================================================
# 14. CLASSIFICATION REPORT
# ==================================================

print("\nClassification Report:")

print(
    classification_report(
        y_test,
        y_pred,
        target_names=[
            "Truthful",
            "Deceptive"
        ]
    )
)


# ==================================================
# 15. CONFUSION MATRIX
# ==================================================

print("Confusion Matrix:")

print(
    confusion_matrix(
        y_test,
        y_pred
    )
)


# ==================================================
# 16. SAVE MODEL COMPONENTS
# ==================================================

joblib.dump(
    model,
    "models/combined_svm.joblib"
)

joblib.dump(
    tfidf,
    "models/combined_tfidf.joblib"
)

joblib.dump(
    scaler,
    "models/combined_scaler.joblib"
)

joblib.dump(
    encoder,
    "models/verified_encoder.joblib"
)

print("\nSaved:")

print("models/combined_svm.joblib")
print("models/combined_tfidf.joblib")
print("models/combined_scaler.joblib")
print("models/verified_encoder.joblib")